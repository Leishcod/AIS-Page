---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import { areasData } from "../../data/areas";
import AreaShowcase from "../../components/areas/AreaShowcase.astro";
import AreaCard from "../../components/areas/AreaCard.astro";
---

<Layout title="Nuestras Áreas | AIS" description="Conoce las direcciones y comités que impulsan la investigación, formación y proyectos dentro de la AIS.">
    <Navbar />
    
    <main class="min-h-screen pt-20 pb-8 bg-[#0B0F19] relative overflow-hidden">
        <!-- Decoraciones de fondo premium (Auras difusas) -->
        <div class="absolute top-[-10%] left-1/2 -translate-x-1/2 w-[1000px] h-[600px] bg-blue-600/15 rounded-full blur-[150px] pointer-events-none"></div>

        <div class="max-w-6xl mx-auto px-6 lg:px-8 relative z-10">
            <!-- Encabezado de la Sección -->
            <div class="mb-5 text-center lg:text-left flex flex-col items-center lg:items-start max-w-3xl">
                <div class="flex items-center gap-3 text-sm font-bold tracking-widest text-blue-300 uppercase mb-2">
                    <span class="w-8 h-[2px] bg-blue-300"></span>
                    ESTRUCTURA ORGANIZACIONAL
                </div>
                <h1 class="text-3xl md:text-4xl font-black text-white leading-tight tracking-tighter mb-3">
                    Nuestras Áreas de <span class="text-blue-300 text-glow-blue">Impacto</span>
                </h1>
                <p class="text-gray-400 text-sm md:text-base font-light leading-relaxed">
                    Conoce las direcciones y comités que impulsan la investigación, formación y proyectos dentro de la Sociedad de Inteligencia Artificial.
                </p>
            </div>

            <!-- Contenedor Principal -->
            <div class="space-y-4">
                <!-- Zona de Exhibición (Showcase) -->
                <div class="grid rounded-[1.5rem] overflow-hidden border border-gray-800/80 bg-[#151F32]/50 shadow-[0_20px_50px_rgba(0,0,0,0.4)] min-h-[300px] lg:min-h-[340px]">
                    {areasData.map((area, index) => (
                        <AreaShowcase area={area} isActive={index === 0} />
                    ))}
                </div>

                <!-- Tarjetas Selectoras -->
                <div class="grid grid-cols-2 md:grid-cols-3 xl:grid-cols-6 gap-3 md:gap-4 mt-4">
                    {areasData.map((area, index) => (
                        <AreaCard id={area.id} title={area.title} iconName={area.iconName} isActive={index === 0} />
                    ))}
                </div>
            </div>
        </div>
    </main>

    <Footer />
</Layout>

<script>
    // Lógica para la interactividad de selección de áreas
    document.addEventListener('DOMContentLoaded', () => {
        const buttons = document.querySelectorAll<HTMLButtonElement>('.area-btn');
        const showcases = document.querySelectorAll<HTMLDivElement>('.showcase-item');

        buttons.forEach(btn => {
            btn.addEventListener('click', () => {
                const targetId = btn.getAttribute('data-area-btn');
                if (!targetId) return;

                // 1. Actualizar estado de los botones
                buttons.forEach(b => {
                    b.setAttribute('data-active', b === btn ? "true" : "false");
                });

                // 2. Actualizar estado de los showcases
                showcases.forEach(showcase => {
                    const showcaseId = showcase.getAttribute('data-showcase');
                    showcase.setAttribute('data-active', showcaseId === targetId ? "true" : "false");
                });
            });
        });
    });
</script>
