---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import { areasData } from "../../data/areas";
import AreaShowcase from "../../components/areas/AreaShowcase.astro";
import AreaCard from "../../components/areas/AreaCard.astro";

const totalAreas = areasData.length;
---

<Layout title="Nuestras Áreas | AIS" description="Conoce las direcciones y comités que impulsan la investigación, formación y proyectos dentro de la AIS.">
    <Navbar />
    
    <main class="min-h-screen pt-20 pb-8 bg-[#0B0F19] relative overflow-hidden">
        <!-- Decoraciones de fondo premium (Auras difusas) -->
        <div class="absolute top-[-10%] left-1/2 -translate-x-1/2 w-[1000px] h-[600px] bg-blue-600/15 rounded-full blur-[150px] pointer-events-none"></div>

        <div class="max-w-6xl mx-auto px-6 lg:px-8 relative z-10">
            <!-- Encabezado compacto: eyebrow + título en línea -->
            <div class="mb-4 flex flex-col lg:flex-row lg:items-end lg:justify-between gap-3">
                <div>
                    <div class="flex items-center gap-3 text-xs font-bold tracking-widest text-blue-300 uppercase mb-1.5">
                        <span class="w-6 h-[2px] bg-blue-300"></span>
                        ESTRUCTURA ORGANIZACIONAL
                    </div>
                    <h1 class="text-2xl md:text-3xl font-black text-white leading-tight tracking-tighter">
                        Nuestras Áreas de <span class="text-blue-300 text-glow-blue">Impacto</span>
                    </h1>
                </div>
                <p class="text-gray-500 text-sm font-light leading-relaxed max-w-md lg:text-right">
                    Direcciones y comités que impulsan la investigación, formación y proyectos de la AIS.
                </p>
            </div>

            <!-- Tarjetas Selectoras (ARRIBA de la tarjeta de detalle) -->
            <div class="grid grid-cols-3 md:grid-cols-6 gap-2 md:gap-3 mb-4">
                {areasData.map((area, index) => (
                    <AreaCard id={area.id} title={area.title} iconName={area.iconName} isActive={index === 0} />
                ))}
            </div>

            <!-- Zona de Exhibición (Showcase) -->
            <div class="grid rounded-[1.25rem] overflow-hidden border border-gray-800/80 bg-[#151F32]/50 shadow-[0_20px_50px_rgba(0,0,0,0.4)] min-h-[320px] lg:min-h-[380px]">
                {areasData.map((area, index) => (
                    <AreaShowcase area={area} isActive={index === 0} index={index} total={totalAreas} />
                ))}
            </div>
        </div>
    </main>

    <Footer />
</Layout>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const buttons = document.querySelectorAll<HTMLButtonElement>('.area-btn');
        const showcases = document.querySelectorAll<HTMLDivElement>('.showcase-item');
        const counter = document.getElementById('area-counter');

        buttons.forEach((btn, btnIndex) => {
            btn.addEventListener('click', () => {
                const targetId = btn.getAttribute('data-area-btn');
                if (!targetId) return;

                // 1. Actualizar estado de los botones
                buttons.forEach(b => {
                    const isSelected = b === btn ? "true" : "false";
                    b.setAttribute('data-active', isSelected);
                    b.setAttribute('aria-pressed', isSelected);
                });

                // 2. Actualizar estado de los showcases
                showcases.forEach(showcase => {
                    const showcaseId = showcase.getAttribute('data-showcase');
                    showcase.setAttribute('data-active', showcaseId === targetId ? "true" : "false");
                });

                // 3. Actualizar contador de posición
                if (counter) {
                    counter.textContent = `${btnIndex + 1} / ${buttons.length}`;
                }
            });
        });
    });
</script>
