---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import HeroProject from "../components/proyectos/HeroProject.astro";
import ProjectsGrid from "../components/proyectos/ProjectsGrid.astro";
import FaqAccordion from "../components/proyectos/FaqAccordion.astro";
import ProjectDrawer from "../components/proyectos/ProjectDrawer.astro";

import { mainProject, projectsList, faqList } from "../data/proyectosData";
---

<Layout title="Proyectos | Artificial Intelligence Society">
  <Navbar />

  <main
    class="relative min-h-screen pt-28 md:pt-[120px] pb-24 overflow-hidden w-full flex flex-col"
  >
    <!-- Decoración de fondo premium estilo Áreas y Eventos -->
    <div
      class="absolute top-[80px] md:top-[120px] left-1/2 -translate-x-1/2 w-[1000px] h-[600px] bg-blue-600/15 rounded-full blur-[150px] pointer-events-none"
    >
    </div>

    <div class="max-w-7xl mx-auto px-6 w-full flex flex-col gap-24 relative z-10">
    <section>
      <div
        class="flex items-center gap-3 text-[14px] font-bold tracking-widest text-blue-300 uppercase mb-6"
      >
        <span class="w-8 h-[2px] bg-blue-300"></span>
        CONOCE NUESTROS PROYECTOS
      </div>
      <HeroProject project={mainProject} />
    </section>

    <section id="grilla-proyectos" class="scroll-mt-32">
      <div
        class="flex items-center gap-3 text-[14px] font-bold tracking-widest text-blue-300 uppercase mb-8"
      >
        <span class="w-8 h-[2px] bg-blue-300"></span>
        NUESTROS PROYECTOS
      </div>
      <ProjectsGrid projects={projectsList} />
    </section>

    <section class="w-full">
      <div
        class="flex items-center gap-3 text-[14px] font-bold tracking-widest text-blue-300 uppercase mb-8"
      >
        <span class="w-8 h-[2px] bg-blue-300"></span>
        PREGUNTAS FRECUENTES
      </div>
      <div class="max-w-4xl mx-auto w-full">
        <FaqAccordion faqs={faqList} />
      </div>
    </section>
  </div>
  </main>

  <Footer />

  <ProjectDrawer projects={[mainProject, ...projectsList]} />
</Layout>
