---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import HeroProject from '../components/proyectos/HeroProject.astro';
import ProjectsGrid from '../components/proyectos/ProjectsGrid.astro';
import FaqAccordion from '../components/proyectos/FaqAccordion.astro';
import ProjectDrawer from '../components/proyectos/ProjectDrawer.astro';

import { mainProject, projectsList, faqList } from '../data/proyectosData';
---

<Layout title="Proyectos | Artificial Intelligence Society">
  <Navbar />
  
  <main class="min-h-screen pt-32 pb-16 px-4 md:px-8 max-w-7xl mx-auto flex flex-col gap-24">
    
    <section>
      <h2 class="text-sm md:text-base text-gray-400 mb-4 tracking-wider uppercase font-medium">Nuestra Visión 2027...</h2>
      <HeroProject project={mainProject} />
    </section>

    <section id="grilla-proyectos" class="scroll-mt-32">
      <h2 class="text-2xl md:text-3xl font-bold mb-8 uppercase tracking-wide">Nuestros Proyectos</h2>
      <ProjectsGrid projects={projectsList} />
    </section>

    <section class="max-w-4xl mx-auto w-full">
      <h2 class="text-2xl md:text-3xl font-bold mb-8 uppercase tracking-wide">Preguntas Frecuentes</h2>
      <FaqAccordion faqs={faqList} />
    </section>

  </main>
  
  <Footer />

  <ProjectDrawer projects={[mainProject, ...projectsList]} />
</Layout>
