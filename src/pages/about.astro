---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import ConocenosHeader from '../components/conocenos/ConocenosHeader.astro';
import NuestraHistoria from '../components/conocenos/NuestraHistoria.astro';
import MisionVision from '../components/conocenos/MisionVision.astro';
import ValoresGrid from '../components/conocenos/ValoresGrid.astro';
---

<Layout 
	title="Conócenos - Artificial Intelligence Society" 
	description="Conoce la historia, misión, visión y valores constitucionales de la Artificial Intelligence Society (AIS)."
>
	<Navbar />

	<main class="relative min-h-screen pt-28 md:pt-[120px] pb-20 overflow-hidden">
		<!-- Decoración de fondo premium estilo Áreas y Eventos -->
		<div class="absolute top-[80px] md:top-[120px] left-1/2 -translate-x-1/2 w-[1000px] h-[600px] bg-blue-600/15 rounded-full blur-[150px] pointer-events-none"></div>
		
		<div class="max-w-7xl mx-auto px-6 relative z-10">
			<!-- Header / Encabezado -->
			<ConocenosHeader />

			<!-- Sección Nuestra Historia -->
			<NuestraHistoria />

			<!-- Sección Misión y Visión -->
			<MisionVision />

			<!-- Sección Valores Constitucionales -->
			<ValoresGrid />
		</div>
	</main>

	<Footer />
</Layout>
