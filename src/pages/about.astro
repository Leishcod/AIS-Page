---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import ConocenosHeader from '../components/conocenos/ConocenosHeader.astro';
import NuestraHistoria from '../components/conocenos/NuestraHistoria.astro';
import MisionVision from '../components/conocenos/MisionVision.astro';
import ValoresGrid from '../components/conocenos/ValoresGrid.astro';
---

<Layout 
	title="Conócenos - Artificial Intelligence Society" 
	description="Conoce la historia, misión, visión y valores constitucionales de la Artificial Intelligence Society (AIS)."
>
	<Navbar />

	<main class="relative min-h-screen pt-10 pb-20 overflow-hidden">
		<!-- Aura Glow decorativa de fondo (Neón azul/cian) -->
		<div class="absolute top-20 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-gradient-to-tr from-cyan-500/10 via-blue-600/10 to-transparent blur-3xl pointer-events-none rounded-full"></div>
		
		<div class="max-w-7xl mx-auto px-6 relative z-10">
			<!-- Header / Encabezado -->
			<ConocenosHeader />

			<!-- Sección Nuestra Historia -->
			<NuestraHistoria />

			<!-- Sección Misión y Visión -->
			<MisionVision />

			<!-- Sección Valores Constitucionales -->
			<ValoresGrid />
		</div>
	</main>

	<Footer />
</Layout>
