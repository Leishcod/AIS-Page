---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import EventStatsBanner from "../components/events/EventStatsBanner.astro";
import EventSponsors from "../components/events/EventSponsors.astro";
import UpcomingEvents from "../components/events/UpcomingEvents.astro";
import EventDirectory from "../components/events/EventDirectory.astro";
import type { Event } from "../types/events";
import DefaultLogo from "../assets/Eventos/DefaultLogo.webp"; //que siempre se importe esto al no tener imagen
import joelVeraImg from "../assets/Eventos/JoelVera.webp";

const eventsData: Event[] = [
  {
    id: "1",
    title: "AWS y la Inteligencia Artificial",
    description:
      "Ponencia de Joel Vera, country manager de AWS en Perú, Ecuador y Bolivia, sobre su trayectoria profesional y liderazgo de AWS",
    date: "Jueves, 17 de setiembre del 2026",
    time: "9:30 am",
    tags: ["AWS", "CONFERENCIA"],
    imageUrl: joelVeraImg.src,
    imageAlt: "Banner del evento",
    status: "past",
    actionLabel: "VER RECAP",
    link: "https://www.instagram.com/p/DeDrmErjpbW/?utm_source=ig_web_copy_link&stkn=NTc4MTIwNjQ2YQ==",
  },
  {
    id: "2",
    title: "Workshop: Python para IA y Análisis de Datos",
    description:
      "Taller práctico en el que los participantes dan sus primeros pasos con Python, trabajando directamente en el navegador con Colab.",
    date: "Sábado, 31 de octubre del 2026",
    time: "2:00 pm",
    tags: ["WORKSHOP", "PYTHON", "DATA SCIENCE"],
    imageUrl: DefaultLogo.src,
    imageAlt: "Banner de Workshop IA",
    status: "upcoming",
    actionLabel: "PRÓXIMAMENTE",
    link: "#",
  },
];
---

<Layout title="Eventos - AIS">
  <Navbar />
  <main
    class="relative overflow-hidden w-full flex flex-col pt-28 md:pt-[120px] pb-24"
  >
    <!-- Decoración de fondo premium estilo Áreas -->
    <div
      class="absolute top-[120px] md:top-[160px] left-1/2 -translate-x-1/2 w-[1000px] h-[600px] bg-blue-600/15 rounded-full blur-[150px] pointer-events-none"
    >
    </div>

    <!-- Hero Header estilo Navbar (Estandarizado con Convocatoria) -->
    <section class="relative z-10 max-w-7xl mx-auto px-6 w-full">
      <div class="text-left mb-10 md:mb-14">
        <!-- Eyebrow / Overline -->
        <div
          class="flex items-center gap-3 text-[14px] font-bold tracking-widest text-blue-300 uppercase"
        >
          <span class="w-8 h-[2px] bg-blue-300"></span>
          EVENTOS AIS
        </div>

        <!-- Título Principal -->
        <h1
          class="mt-7 text-[48px] md:text-[62px] lg:text-[72px] font-black text-white leading-[1.05] tracking-tighter max-w-4xl"
        >
          Conecta y Participa en <span class="text-blue-300 text-glow-blue"
            >IA</span
          >
        </h1>

        <!-- Descripción -->
        <p
          class="mt-7 text-[16px] md:text-[18px] text-gray-400 font-light leading-relaxed max-w-2xl"
        >
          Charlas, talleres y más para estudiantes y profesionales. Todos
          nuestros eventos están abiertos a la comunidad.
        </p>
      </div>

      <!-- Cifras de eventos abajo -->
      <EventStatsBanner />
    </section>

    <UpcomingEvents events={eventsData} />

    <EventDirectory
      events={eventsData.filter((e) => e.status !== "upcoming")}
    />

    <EventSponsors />
  </main>
  <Footer />
</Layout>

<style>
  .glow-text {
    text-shadow: 0 0 20px rgba(56, 189, 248, 0.5);
  }
</style>
