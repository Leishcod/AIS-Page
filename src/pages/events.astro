    date: "Martes, 15 de marzo del 2026",
    time: "6 pm",
    tags: ["TALLER", "NLP"],
    imageUrl: "https://lh3.googleusercontent.com/aida-public/AB6AXuA1faK_p-MasmfBzxh2ruXtYrLMLVrZJfJtQnNrx6xuelyf9QtAyoRuLd5QR2aioAPIQ7-9CYtAPcCUAXTsOxbBAJAYj1BN-CvNaCPSmAMxtafhwgUNOB4hzqp3JcEwf0ZHOBgODKwRU94dG_X5JDSlFB4VmLCQAN5CQYBdip1rxcGaq0VyXGdKbNQtmIPxrHl-II879uRmYUg7RaLz7G1Xoo-Tgo956CSj-b6ZM6YnEyM9fmb3AnvH",
    status: "past",
    link: "https://ejemplo.com/info-taller"
  },
  {
    id: "3",
    title: "Hackathon: Robótica",
    description: "Competencia intensiva de 48 horas para desarrollar soluciones de robótica autónoma e integración de IA física en entornos reales.",
    date: "Viernes, 10 de enero del 2026",
    time: "9 am",
    tags: ["HACKATHON", "COMPETENCIA"],
    imageUrl: "https://lh3.googleusercontent.com/aida-public/AB6AXuA6wcGHAIDcn1SGFFHHnomzVeAZFDEP7vD6w3AYgvrHmnTn5JuxakPxrTTid4M7hzI3SB8577T4OZVqiXN4Z7FhISIICBnsTkh8ChH5zCjW85eR5muKlNy1HziTYfEydbWzfHeY2VYh85ETYMoWaT4kn6bdB9DX9fgLKIqPO14fVa6K5qyVMjkCgBfPPGIr7SSjsqNAVz6onMG0hOswbAFGBM8ZPFLo9fP9Gjz72tR3h2l9ewT-fqK1",
