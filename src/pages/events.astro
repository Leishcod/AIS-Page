---
<Layout title="Eventos - AIS">
    <Navbar/>
    <main class="relative overflow-hidden w-full flex flex-col pt-12 pb-24">
        <section class="flex flex-col items-center text-center space-y-4 relative z-10 max-w-7xl mx-auto px-6 pt-20">
            <h1 class="text-[50px] md:text-[62px] lg:text-[74px] font-black text-white leading-[1.1] tracking-tighter text-glow-blue mb-8">Eventos</h1>
            
            <EventStatsBanner/>
        </section>

        <UpcomingEvents events={eventsData} />
        
        <EventDirectory events={eventsData.filter(e => e.status !== 'upcoming')} />
        
        <EventSponsors />
    </main>
    <Footer/>
</Layout>

<style>
    .glow-text {
        text-shadow: 0 0 20px rgba(56, 189, 248, 0.5);
    }
</style>
