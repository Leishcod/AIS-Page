---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import EventStatsBanner from "../components/events/EventStatsBanner.astro";
import EventSponsors from "../components/events/EventSponsors.astro";
import UpcomingEvents from "../components/events/UpcomingEvents.astro";
import EventDirectory from "../components/events/EventDirectory.astro";
import type { Event } from "../types/events";
import joelVeraImg from "../assets/Eventos/JoelVera.webp"; //momentáneamente usaremos esta práctica

const eventsData: Event[] = [
  {
    id: "1",
    title: "Taller: NLP Avanzado",
    description:
      "Una sesión práctica sobre el procesamiento de lenguaje natural y el entrenamiento de modelos fundacionales para aplicaciones específicas.",
    date: "Martes, 15 de marzo del 2026",
    time: "6 pm",
    tags: ["TALLER", "NLP"],
    imageUrl:
      "https://lh3.googleusercontent.com/aida-public/AB6AXuA1faK_p-MasmfBzxh2ruXtYrLMLVrZJfJtQnNrx6xuelyf9QtAyoRuLd5QR2aioAPIQ7-9CYtAPcCUAXTsOxbBAJAYj1BN-CvNaCPSmAMxtafhwgUNOB4hzqp3JcEwf0ZHOBgODKwRU94dG_X5JDSlFB4VmLCQAN5CQYBdip1rxcGaq0VyXGdKbNQtmIPxrHl-II879uRmYUg7RaLz7G1Xoo-Tgo956CSj-b6ZM6YnEyM9fmb3AnvH",
    imageAlt: "Taller de procesamiento de lenguaje natural",
    status: "past",
    link: "https://ejemplo.com/info-taller",
  },
  {
    id: "2",
    title: "Hackathon: Robótica",
    description:
      "Competencia intensiva de 48 horas para desarrollar soluciones de robótica autónoma e integración de IA física en entornos reales.",
    date: "Viernes, 10 de enero del 2026",
    time: "9 am",
    tags: ["HACKATHON", "COMPETENCIA"],
    imageUrl:
      "https://lh3.googleusercontent.com/aida-public/AB6AXuA6wcGHAIDcn1SGFFHHnomzVeAZFDEP7vD6w3AYgvrHmnTn5JuxakPxrTTid4M7hzI3SB8577T4OZVqiXN4Z7FhISIICBnsTkh8ChH5zCjW85eR5muKlNy1HziTYfEydbWzfHeY2VYh85ETYMoWaT4kn6bdB9DX9fgLKIqPO14fVa6K5qyVMjkCgBfPPGIr7SSjsqNAVz6onMG0hOswbAFGBM8ZPFLo9fP9Gjz72tR3h2l9ewT-fqK1",
    imageAlt:
      "A robotic arm assembling a delicate component in a sterile, high-tech lab environment. Clinical white and cyan lighting. Focus on precision and automation.",
    status: "past",
  },
  {
    id: "3",
    title: "AWS y la Inteligencia Artificial",
    description:
      "Ponencia de Joel Vera, country manager de AWS en Perú, Ecuador y Bolivia, sobre su trayectoria profesional y liderazgo de AWS",
    date: "Jueves, 17 de setiembre del 2026",
    time: "9:30 am",
    tags: ["AWS", "CONFERENCIA"],
    imageUrl: joelVeraImg.src, //momentáneamente usaremos esta práctica
    imageAlt: "Banner del evento",
    status: "upcoming",
    link: "https://luma.com/aenmebnb",
  },
];
---

<Layout title="Eventos - AIS">
  <Navbar />
  <main class="relative overflow-hidden w-full flex flex-col pt-12 pb-24">
    <section
      class="flex flex-col items-center text-center space-y-4 relative z-10 max-w-7xl mx-auto px-6 pt-20"
    >
      <!-- Seamless Ambient Backlight Center Glows -->
      <div
        class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[1100px] h-[720px] bg-blue-600/15 rounded-full blur-[180px] pointer-events-none"
      >
      </div>
      <div
        class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[520px] bg-cyan-500/12 rounded-full blur-[140px] pointer-events-none"
      >
      </div>

      <h1
        class="text-[70px] md:text-[85px] lg:text-[100px] font-black text-white leading-[1.1] tracking-tighter text-glow-blue mb-8 relative z-10"
      >
        Eventos
      </h1>

      <EventStatsBanner />
    </section>

    <UpcomingEvents events={eventsData} />

    <EventDirectory
      events={eventsData.filter((e) => e.status !== "upcoming")}
    />

    <EventSponsors />
  </main>
  <Footer />
</Layout>

<style>
  .glow-text {
    text-shadow: 0 0 20px rgba(56, 189, 248, 0.5);
  }
</style>
