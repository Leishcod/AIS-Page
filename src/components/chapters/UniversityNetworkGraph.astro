<!-- Client Script for Interactive Synaptic Resonance on Hover and Modal Invocation -->
<script>
	function initSynapticResonance() {
		const nodes = document.querySelectorAll('.chapter-node');
		const pathways = document.querySelectorAll('.pathway-line');

		nodes.forEach((nodeEl) => {
			const chapterId = nodeEl.getAttribute('data-chapter-id');
			if (!chapterId) return;

			nodeEl.addEventListener('mouseenter', () => {
				pathways.forEach((p) => {
					const pathEl = p as SVGPathElement;
					pathEl.classList.add('synapse-overload');
				});
			});

			nodeEl.addEventListener('mouseleave', () => {
				pathways.forEach((p) => {
					const pathEl = p as SVGPathElement;
					pathEl.classList.remove('synapse-overload');
				});
			});

			// Direct Click & Keyboard interactions to open chapter detail modal
			const triggerOpen = (e: Event) => {
				e.preventDefault();
				e.stopPropagation();
				if ((window as any).openChapterModal) {
					(window as any).openChapterModal(chapterId);
				} else {
					window.dispatchEvent(new CustomEvent('open-chapter-modal', { detail: { chapterId } }));
				}
			};

			nodeEl.addEventListener('click', triggerOpen);

			nodeEl.addEventListener('keydown', (e: any) => {
				if (e.key === 'Enter' || e.key === ' ') {
					triggerOpen(e);
				}
			});
		});
	}

	initSynapticResonance();
	document.addEventListener('astro:after-swap', initSynapticResonance);
</script>

