---
import type { Chapter } from '../../types/chapters';

interface Props {
	chapters: Chapter[];
}

const { chapters } = Astro.props as Props;

// Helper to extract clean initials
const KNOWN_ACRONYMS: Record<string, string> = {
	'ais-uni': 'UNI',
	'ais-pucp': 'PUCP',
	'ais-utec': 'UTEC',
	'ais-unmsm': 'UNMSM',
	'ais-upc': 'UPC',
	'ais-unsa': 'UNSA',
	'ais-unt': 'UNT',
};

const getInitials = (id: string, name: string): string => {
	if (KNOWN_ACRONYMS[id]) return KNOWN_ACRONYMS[id];
	const words = name
		.split(' ')
		.filter((w) => !['de', 'la', 'del', 'y', 'el', 'los', 'las', 'en', 'para'].includes(w.toLowerCase()));
	if (words.length >= 2) {
		return (words[0][0] + words[1][0] + (words[2] ? words[2][0] : '')).toUpperCase();
	}
	return name.slice(0, 4).toUpperCase();
};

const findChapter = (id: string) => chapters.find((c) => c.id === id) || chapters[0];

const uni = findChapter('ais-uni');
---

