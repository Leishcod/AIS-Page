---
import type { AreaIconName } from "../../data/areas";

interface Props {
	id: string;
	title: string;
	iconName: AreaIconName;
	isActive?: boolean;
}

const { id, title, iconName, isActive = false } = Astro.props as Props;

const getIcon = (name: AreaIconName) => {
    switch (name) {
        case "academica": 
            return `<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 md:w-6 md:h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 14l9-5-9-5-9 5 9 5z" /><path stroke-linecap="round" stroke-linejoin="round" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" /><path stroke-linecap="round" stroke-linejoin="round" d="M12 14v7" /></svg>`;
        case "relaciones":
            return `<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 md:w-6 md:h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" /></svg>`;
        case "marketing":
            return `<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 md:w-6 md:h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z" /></svg>`;
        case "tecnologia":
            return `<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 md:w-6 md:h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01" /></svg>`;
        case "proyectos":
            return `<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 md:w-6 md:h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10a2 2 0 002 2h2a2 2 0 002-2M9 7a2 2 0 012-2h2a2 2 0 012 2m0 10V7m0 10a2 2 0 002 2h2a2 2 0 002-2V7a2 2 0 00-2-2h-2a2 2 0 00-2 2" /></svg>`;
        case "auspicio":
            return `<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 md:w-6 md:h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`;
        default:
            return "";
    }
};
---

<button
    data-area-btn={id}
    data-active={isActive ? "true" : "false"}
    aria-label={`Ver área: ${title}`}
    aria-pressed={isActive ? "true" : "false"}
    class="area-btn group flex flex-col items-center justify-center py-2.5 px-2 md:py-3 md:px-3 rounded-xl border transition-all duration-300 relative overflow-hidden h-full w-full"
>
    <!-- Brillo interno animado en active -->
    <div class="btn-glow absolute inset-0 bg-gradient-to-b from-blue-400/10 to-transparent transition-opacity duration-300 pointer-events-none"></div>

    <!-- Icon Container -->
    <div class="btn-icon mb-1.5 transition-colors duration-300" set:html={getIcon(iconName)} />

    <!-- Title -->
    <h3 class="btn-text text-[10px] md:text-xs font-bold text-center leading-tight transition-colors duration-300">
        {title}
    </h3>
</button>

<style>
    @reference "../../styles/global.css";
    .area-btn {
        @apply bg-[#0F1423]/50 border-gray-800 hover:bg-[#151F32] hover:border-blue-500/30 hover:shadow-[0_0_15px_rgba(96,165,250,0.1)];
    }
    .area-btn[data-active="true"] {
        @apply bg-blue-500/10 border-blue-400 shadow-[0_0_20px_rgba(96,165,250,0.25)];
    }
    .area-btn .btn-glow { @apply opacity-0; }
    .area-btn[data-active="true"] .btn-glow { @apply opacity-100; }
    
    .area-btn .btn-icon { @apply text-gray-500; }
    .area-btn:hover .btn-icon { @apply text-blue-200; }
    .area-btn[data-active="true"] .btn-icon, .area-btn[data-active="true"]:hover .btn-icon { @apply text-blue-300; }

    .area-btn .btn-text { @apply text-gray-400; }
    .area-btn:hover .btn-text { @apply text-gray-200; }
    .area-btn[data-active="true"] .btn-text, .area-btn[data-active="true"]:hover .btn-text { @apply text-white; }
</style>
