---
import type { AreaInfo, AreaIconName } from "../../data/areas";
import { Image } from "astro:assets";

interface Props {
	area: AreaInfo;
	isActive?: boolean;
	index: number;
	total: number;
}

const { area, isActive = false, index, total } = Astro.props as Props;

/** Returns a large decorative SVG for the showcase background, keyed by area */
const getLargeIcon = (name: AreaIconName): string => {
    switch (name) {
        case "academica":
            return `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="0.8"><path stroke-linecap="round" stroke-linejoin="round" d="M12 14l9-5-9-5-9 5 9 5z" /><path stroke-linecap="round" stroke-linejoin="round" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" /><path stroke-linecap="round" stroke-linejoin="round" d="M12 14v7" /></svg>`;
        case "relaciones":
            return `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="0.8"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" /></svg>`;
        case "marketing":
            return `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="0.8"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z" /></svg>`;
        case "tecnologia":
            return `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="0.8"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01" /></svg>`;
        case "proyectos":
            return `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="0.8"><path stroke-linecap="round" stroke-linejoin="round" d="M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10a2 2 0 002 2h2a2 2 0 002-2M9 7a2 2 0 012-2h2a2 2 0 012 2m0 10V7m0 10a2 2 0 002 2h2a2 2 0 002-2V7a2 2 0 00-2-2h-2a2 2 0 00-2 2" /></svg>`;
        case "auspicio":
            return `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="0.8"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`;
        default:
            return "";
    }
};
---

<div 
    id={`showcase-${area.id}`} 
    data-showcase={area.id}
    data-active={isActive ? "true" : "false"}
    class="showcase-item col-start-1 row-start-1 w-full h-full bg-[#0B0F19] isolate rounded-[1.25rem] transition-all duration-700 ease-in-out"
>
    <div class="grid grid-cols-1 lg:grid-cols-12 h-full">
        <!-- Imagen (Izquierda) -->
        <div class="relative lg:col-span-5 h-[260px] lg:h-full overflow-hidden bg-[#0B0F19]">
            <Image 
                src={area.image} 
                alt={area.imageAlt} 
                class="w-full h-full object-cover opacity-80 mix-blend-screen filter contrast-125"
                quality="high"
            />
            <!-- Degradado para mezclar la imagen con la parte derecha -->
            <div class="absolute inset-0 bg-gradient-to-t lg:bg-gradient-to-r from-[#0B0F19] via-[#0B0F19]/40 to-transparent"></div>
        </div>

        <!-- Contenido (Derecha) -->
        <div class="lg:col-span-7 flex flex-col justify-center p-6 lg:p-10 bg-[#0B0F19] relative overflow-hidden">
            <!-- Ícono decorativo grande del área (reemplaza el hexágono genérico) -->
            <div class="absolute right-4 lg:right-8 top-1/2 -translate-y-1/2 w-40 h-40 lg:w-56 lg:h-56 text-blue-400/[0.07] pointer-events-none" set:html={getLargeIcon(area.iconName)} />

            <!-- Indicador de posición -->
            <div class="flex items-center gap-3 mb-3 relative z-10">
                <span id={isActive ? "area-counter" : undefined} class="area-counter-item text-xs font-mono text-blue-300/60 tracking-widest">
                    {index + 1} / {total}
                </span>
                <span class="w-8 h-[1px] bg-blue-300/20"></span>
            </div>

            <!-- Título Principal Neón -->
            <h2 class="text-[28px] lg:text-[36px] font-black text-blue-300 text-glow-blue mb-2 tracking-tight leading-tight relative z-10">
                {area.title}
            </h2>
            
            <div class="space-y-2 relative z-10">
                <h3 class="text-base lg:text-lg text-white font-bold tracking-wide">
                    {area.subtitle}
                </h3>
                <p class="text-gray-400 text-sm font-light leading-relaxed mb-4 max-w-md">
                    {area.mission}
                </p>
                
                <div class="pt-2">
                    <a 
                        href={`/proyectos?area=${area.id}`} 
                        class="inline-flex items-center gap-2 px-5 py-2.5 text-xs font-bold text-gray-950 bg-blue-300 hover:bg-blue-200 transition-all w-fit rounded-none hover:-translate-y-0.5 hover:shadow-[0_0_20px_rgba(96,165,250,0.5)]"
                    >
                        VER PROYECTOS 
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                        </svg>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    @reference "../../styles/global.css";
    .showcase-item {
        @apply opacity-0 translate-y-8 z-0 pointer-events-none;
    }
    .showcase-item[data-active="true"] {
        @apply opacity-100 translate-y-0 z-10 pointer-events-auto;
    }
</style>
