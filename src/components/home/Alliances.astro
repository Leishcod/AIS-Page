---
/**
 * Alliances.astro
 * Sección de Alianzas con marquesina infinita interactiva (de izquierda a derecha).
 *
 * Cuenta con función de respaldo (fallback):
 * - Si hay una imagen importada en `logo`, muestra el logo con efectos visuales.
 * - Si `logo` es null/undefined (no hay imagen aún), muestra un recuadro elegante
 *   con el texto de la alianza, manteniendo el tooltip superior.
 */

import codeLogo from "../../assets/Home/Code_Logo.webp";
import ieeeCisLogo from "../../assets/Home/IEEE_CIS_UNI_Logo.webp";
import unicodeLogo from "../../assets/Home/UNICODE_Logo.webp";
import awsSbgLogo from "../../assets/Home/AWS_SBG_UNI_Logo.webp";

interface Alliance {
  name: string;
  logo?: any;
  scale?: string;
  hoverScale?: string;
  brightness?: string;
}

// Configuración de las 5 alianzas con sus respectivos logos y escalas visuales
const alianzas: Alliance[] = [
  {
    name: "CODE",
    logo: codeLogo,
    scale: "scale-[1.45] md:scale-[1.65]",
    hoverScale: "group-hover:scale-[1.55] md:group-hover:scale-[1.75]",
  },
  {
    name: "IEEE CIS UNI",
    logo: ieeeCisLogo,
    scale: "scale-[1.3] md:scale-[1.45]",
    hoverScale: "group-hover:scale-[1.4] md:group-hover:scale-[1.55]",
  },
  {
    name: "UNICODE",
    logo: unicodeLogo,
    scale: "scale-[1.15] md:scale-[1.25]",
    hoverScale: "group-hover:scale-[1.25] md:group-hover:scale-[1.35]",
  },
  {
    name: "DSC UNI",
    logo: null,
  },
  {
    name: "AWS Student Builder Group UNI",
    logo: awsSbgLogo,
    scale: "scale-[1.2] md:scale-[1.35]",
    hoverScale: "group-hover:scale-[1.3] md:group-hover:scale-[1.45]",
  },
];

// Función para resolver de forma segura la URL o src de la imagen si existe
const getLogoSrc = (logo: any): string | null => {
  if (!logo) return null;
  if (typeof logo === "string") return logo;
  if (typeof logo === "object" && logo.src) return logo.src;
  return null;
};

// Repetimos 4 veces para garantizar bucle infinito sin cortes en cualquier resolución
const alianzasMarquee = [...alianzas, ...alianzas, ...alianzas, ...alianzas];
---

<section
  id="alianzas"
  class="w-full py-16 md:py-24 relative overflow-hidden border-t border-gray-900/60"
>
  <div class="max-w-7xl mx-auto px-6">
    <div class="text-center mb-6">
      <h2
        class="text-[30px] sm:text-[38px] md:text-[50px] font-black text-white tracking-tight"
      >
        NUESTRAS <span class="text-blue-300 text-glow-blue">ALIANZAS</span>
      </h2>
    </div>

    <p
      class="text-gray-400 text-[16px] md:text-[18px] text-center max-w-2xl mx-auto mb-14 leading-relaxed font-light"
    >
      Construimos sinergias con comunidades e instituciones referentes para
      acelerar la investigación científica, el talento de élite y el desarrollo
      tecnológico en Inteligencia Artificial.
    </p>

    <!-- Marquesina de una sola cinta con degradado en los extremos -->
    <div class="overflow-hidden mask-image-fade py-6">
      <div class="relative w-full flex overflow-hidden py-16 -my-4">
        <div
          class="animate-marquee flex gap-16 md:gap-24 whitespace-nowrap items-center h-full"
        >
          {
            alianzasMarquee.map((alianza) => {
              const src = getLogoSrc(alianza.logo);
              return (
                <div class="group relative flex items-center justify-center min-w-[180px] md:min-w-[240px] h-28 md:h-36 transition-all duration-300">
                  {src ? (
                    <img
                      src={src}
                      alt={alianza.name}
                      title={alianza.name}
                      class={`h-16 md:h-24 max-w-[180px] md:max-w-[230px] w-auto object-contain opacity-65 grayscale ${alianza.brightness || "brightness-125"} ${alianza.scale || "scale-100"} ${alianza.hoverScale || "group-hover:scale-110"} contrast-125 group-hover:opacity-100 group-hover:grayscale-0 group-hover:brightness-100 transition-all duration-500`}
                    />
                  ) : (
                    <div class="h-14 md:h-20 px-6 md:px-9 rounded-2xl border border-gray-800 bg-[#172033]/50 flex items-center justify-center text-center opacity-75 group-hover:opacity-100 group-hover:border-blue-500/40 group-hover:bg-[#172033]/90 transition-all duration-500 shadow-lg">
                      <span class="text-[12px] md:text-[16px] font-bold tracking-wider uppercase text-gray-200 group-hover:text-blue-300 transition-colors duration-300 select-none whitespace-nowrap">
                        {alianza.name}
                      </span>
                    </div>
                  )}

                  {/* Tooltip flotante superior */}
                  <div class="absolute -top-2 left-1/2 -translate-x-1/2 opacity-0 group-hover:opacity-100 group-hover:-top-11 transition-all duration-500 pointer-events-none z-50">
                    <span class="bg-[#0B0F19]/95 text-blue-300 text-[10px] md:text-[14px] font-bold px-4 py-2 rounded-full border border-blue-500/30 whitespace-nowrap shadow-2xl backdrop-blur-md">
                      {alianza.name}
                    </span>
                  </div>
                </div>
              );
            })
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Edge gradient masking for fading marquee boundaries */
  .mask-image-fade {
    mask-image: linear-gradient(
      to right,
      transparent,
      black 15%,
      black 85%,
      transparent
    );
    -webkit-mask-image: linear-gradient(
      to right,
      transparent,
      black 15%,
      black 85%,
      transparent
    );
  }

  .animate-marquee {
    animation: marquee 35s linear infinite;
  }

  .animate-marquee:hover {
    animation-play-state: paused;
  }

  /* Movimiento continuo de izquierda a derecha */
  @keyframes marquee {
    0% {
      transform: translateX(-50%);
    }
    100% {
      transform: translateX(0);
    }
  }
</style>
