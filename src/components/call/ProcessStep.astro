---
interface Props {
  number: string;
  title: string;
  description: string;
  last?: boolean;
}

const { number, title, description, last = false } = Astro.props as Props;
---

<div class="relative flex md:block gap-5">
  <div class="relative flex flex-col items-center md:block">
    <div
      class="w-11 h-11 rounded-full border border-blue-400/40 bg-[#0B0F19] text-blue-300 flex items-center justify-center font-bold text-sm relative z-10"
    >
      {number}
    </div>

    {!last && <div class="w-px flex-1 bg-gray-800 md:hidden" />}
  </div>

  <div class="pb-10 md:pb-0 md:mt-6">
    <h3 class="text-lg font-bold text-white">
      {title}
    </h3>

    <p class="mt-2 text-sm leading-relaxed text-gray-400">
      {description}
    </p>
  </div>
</div>
