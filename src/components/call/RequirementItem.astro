---
interface Props {
  text: string;
}

const { text } = Astro.props as Props;
---

<li class="flex items-start gap-4">
  <div
    class="mt-0.5 w-6 h-6 rounded-full border border-blue-500/30 bg-blue-500/5 flex items-center justify-center text-blue-300 shrink-0"
  >
    <svg
      class="w-3.5 h-3.5"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
      stroke-width="2.5"
    >
      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"
      ></path>
    </svg>
  </div>

  <span class="text-gray-300 leading-relaxed">
    {text}
  </span>
</li>
