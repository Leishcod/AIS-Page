---
interface Props {
  title: string;
  description: string;
  icon: "learning" | "project" | "community" | "growth";
}

const { title, description, icon } = Astro.props as Props;
---

<article
  class="p-6 md:p-7 rounded-2xl border border-gray-800/80 bg-[#0F1423]/20 hover:bg-blue-500/5 hover:border-blue-500/30 transition-all duration-300 group"
>
  <div
    class="w-11 h-11 mb-6 rounded-xl bg-blue-500/5 border border-blue-500/20 text-blue-300/70 flex items-center justify-center group-hover:text-blue-200 transition-colors"
  >
    {
      icon === "learning" && (
        <svg
          class="w-5 h-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path d="M12 3a6 6 0 00-6 6c0 2.5 1.5 4 3 5v3h6v-3c1.5-1 3-2.5 3-5a6 6 0 00-6-6z" />
          <path d="M9 21h6" />
        </svg>
      )
    }

    {
      icon === "project" && (
        <svg
          class="w-5 h-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path d="M5 19c4-8 8-12 14-14-2 6-6 10-14 14z" />
          <path d="M9 15l-4 4" />
        </svg>
      )
    }

    {
      icon === "community" && (
        <svg
          class="w-5 h-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <circle cx="8" cy="8" r="3" />
          <circle cx="17" cy="9" r="2" />
          <path d="M3 20c0-4 2-7 5-7s5 3 5 7M14 15c3 0 5 2 5 5" />
        </svg>
      )
    }

    {
      icon === "growth" && (
        <svg
          class="w-5 h-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path d="M4 18l5-5 4 3 7-9" />
          <path d="M15 7h5v5" />
        </svg>
      )
    }
  </div>

  <h3 class="text-xl font-bold text-white">
    {title}
  </h3>

  <p class="mt-3 text-sm md:text-base leading-relaxed text-gray-400">
    {description}
  </p>
</article>
