---
interface Props {
  id: string;
  name: string;
  description: string;
  icon: "cpu" | "operations" | "marketing" | "people";
}

const { id, name, description, icon } = Astro.props as Props;
---

<button
  type="button"
  class="area-card group w-full text-left p-6 md:p-7 rounded-2xl bg-[#0F1423]/25 border border-gray-800/80 hover:border-blue-500/30 hover:bg-blue-500/5 transition-all duration-300"
  data-area={id}
>
  <div
    class="w-12 h-12 mb-6 rounded-xl border border-blue-500/20 bg-blue-500/5 flex items-center justify-center text-blue-300/70 group-hover:text-blue-200 group-hover:bg-blue-500/10 transition-all"
  >
    {
      icon === "cpu" && (
        <svg
          class="w-6 h-6"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <rect x="5" y="5" width="14" height="14" rx="2" />
          <path d="M9 1v4M15 1v4M9 19v4M15 19v4M1 9h4M1 15h4M19 9h4M19 15h4M9 9h6v6H9z" />
        </svg>
      )
    }

    {
      icon === "operations" && (
        <svg
          class="w-6 h-6"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path d="M4 6h16M4 12h10M4 18h16" />
          <circle cx="17" cy="12" r="2" />
        </svg>
      )
    }

    {
      icon === "marketing" && (
        <svg
          class="w-6 h-6"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path d="M3 11l18-7-7 18-3-8-8-3z" />
        </svg>
      )
    }

    {
      icon === "people" && (
        <svg
          class="w-6 h-6"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <circle cx="9" cy="8" r="3" />
          <circle cx="17" cy="9" r="2" />
          <path d="M3 20c0-4 2.5-7 6-7s6 3 6 7M15 14c3 0 5 2 5 5" />
        </svg>
      )
    }
  </div>

  <h3
    class="text-xl md:text-2xl font-bold text-white group-hover:text-blue-300 transition-colors"
  >
    {name}
  </h3>

  <p class="mt-3 text-sm md:text-base leading-relaxed text-gray-400">
    {description}
  </p>

  <div class="mt-6 flex items-center gap-2 text-sm font-semibold text-blue-300">
    <span>Conocer el área</span>
    <span class="transition-transform duration-300 group-hover:translate-x-1">
      →
    </span>
  </div>
</button>
