---
import type { Project } from '../../types/proyectos';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<div class="border border-slate-800 rounded-2xl overflow-hidden bg-slate-900/40 flex flex-col lg:flex-row group transition-all duration-500 hover:border-slate-700">
  <div class="p-8 md:p-12 lg:w-1/2 flex flex-col justify-center order-2 lg:order-1">
    <h3 class="text-3xl md:text-5xl font-bold mb-6 font-outfit text-white group-hover:text-blue-400 transition-colors duration-300">
      {project.title}
    </h3>
    <p class="text-slate-400 mb-8 text-base md:text-lg leading-relaxed">
      {project.shortDescription}
    </p>
    {project.startDate && (
      <p class="text-blue-400 font-medium mb-10 text-sm md:text-base">
        {project.startDate}
      </p>
    )}
    <a 
      href="#grilla-proyectos" 
      class="inline-flex items-center justify-center border border-slate-700 hover:border-blue-500 hover:text-blue-400 bg-slate-900 hover:bg-slate-800 px-8 py-4 rounded-xl text-sm md:text-base font-semibold transition-all duration-300 w-fit"
    >
      Ver más Proyectos
    </a>
  </div>
  
  <div class="lg:w-1/2 bg-slate-950 min-h-[300px] lg:min-h-[500px] flex items-center justify-center relative overflow-hidden order-1 lg:order-2">
    <!-- Placeholder for Hero Image, applying Neon/Dark aesthetic -->
    <div class="absolute inset-0 bg-gradient-to-br from-blue-900/30 via-slate-900/50 to-black z-10"></div>
    
    <div class="absolute inset-0 opacity-20 z-0 bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-blue-500 via-transparent to-transparent"></div>
    
    <span class="text-7xl md:text-9xl font-black text-white/5 z-20 select-none tracking-tighter">AIS</span>
    
    <div class="absolute bottom-4 right-4 z-20 text-xs text-slate-500">
      Artificial Intelligence Society
    </div>
  </div>
</div>
