---
import type { Project } from '../../types/proyectos';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="relative overflow-hidden rounded-2xl border border-gray-800 hover:border-blue-500/30 transition-all duration-300 hover:shadow-[0_0_35px_rgba(96,165,250,0.15)] group min-h-[400px] md:min-h-[500px] flex items-center p-8 md:p-12">
  <!-- Background image with scale on hover -->
  <div class="absolute inset-0 w-full h-full bg-slate-950 group-hover:scale-[1.02] transition-transform duration-500 pointer-events-none">
    <!-- If you have a real image in project.image, use it here. For now, an abstract background. -->
    <div class="absolute inset-0 bg-gradient-to-br from-blue-900/30 via-slate-900/50 to-[#0B0F19] z-10"></div>
    <div class="absolute inset-0 opacity-20 z-0 bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-blue-500 via-transparent to-transparent"></div>
    <div class="absolute right-0 top-1/2 -translate-y-1/2 translate-x-1/4 opacity-10 font-black text-[300px] select-none pointer-events-none text-white tracking-tighter mix-blend-overlay">AIS</div>
  </div>

  <!-- Gradients overlay for legibility (Matched with CongressCard) -->
  <div class="absolute inset-0 bg-gradient-to-r from-[#0B0F19]/95 via-[#0B0F19]/80 to-transparent pointer-events-none z-10"></div>
  <div class="absolute inset-0 bg-gradient-to-t from-[#0B0F19]/90 via-transparent to-transparent pointer-events-none z-10"></div>

  <!-- Content container -->
  <div class="relative z-20 w-full flex flex-col lg:flex-row items-center gap-10 justify-between">
    
    <!-- Text Content -->
    <div class="space-y-6 lg:w-3/5 max-w-2xl">
      <!-- Title -->
      <h3 
        class="text-[36px] md:text-[50px] lg:text-[58px] font-black text-white leading-[1.1] tracking-tight"
        set:html={project.title.replace(' on ', '<br />on ')}
      ></h3>

      <!-- Metadata (Date / Location mimicking CongressCard style) -->
      {project.startDate && (
        <div class="flex flex-wrap items-center gap-5 text-[14px] md:text-[16px] text-gray-300 font-semibold">
          <span class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
            </svg>
            {project.startDate}
          </span>
        </div>
      )}

      <!-- Description -->
      <p class="text-gray-400 text-[15px] md:text-[17px] lg:text-[18px] font-light leading-relaxed">
        {project.shortDescription}
      </p>

      <div class="pt-4">
        <a 
          href="#grilla-proyectos" 
          class="inline-block px-8 py-3.5 text-sm font-bold text-gray-950 bg-blue-300 hover:bg-blue-200 rounded-none transition-all transform hover:-translate-y-0.5 hover:shadow-[0_0_25px_rgba(96,165,250,0.8)]"
        >
          VER MÁS PROYECTOS
        </a>
      </div>
    </div>

    <!-- Image Placeholder -->
    <div class="lg:w-2/5 flex justify-center lg:justify-end w-full">
       <div class="aspect-square w-full max-w-[350px] rounded-2xl border border-gray-800 bg-slate-900/60 shadow-2xl flex flex-col items-center justify-center gap-3 group-hover:border-blue-500/40 transition-colors duration-300">
         <svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12 text-slate-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
           <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
         </svg>
         <span class="text-slate-600 font-semibold tracking-widest text-xs uppercase">Imagen del Proyecto</span>
       </div>
    </div>
  </div>
</article>
