---
import type { Event } from "../../types/events";

interface Props {
  event: Event;
}

const { event } = Astro.props;
---

<div class={`event-card bg-[#172033] rounded-xl border border-gray-800 overflow-hidden group hover:border-blue-500/50 hover:shadow-[0_0_20px_rgba(59,130,246,0.15)] transition-all duration-300 flex flex-col`} data-tags={event.tags.join(',')}>
  <div class="h-48 w-full bg-gray-900 relative overflow-hidden">
    <img 
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 opacity-90" 
      alt={event.imageAlt} 
      src={event.imageUrl} 
    />
    <div class="absolute inset-0 bg-gradient-to-t from-[#172033] to-transparent"></div>
  </div>
  <div class="p-6 flex flex-col flex-grow">
    <h3 class="text-[24px] leading-8 font-bold text-white mb-3">{event.title}</h3>
    <p class="text-sm md:text-base text-gray-400 mb-6 line-clamp-3">{event.description}</p>
    
    <div class="mt-auto space-y-6">
      <div class="flex items-center space-x-2 text-gray-300 text-sm font-medium">
        <img src="/icons/calendar_month.svg" alt="Calendar" class="w-[18px] h-[18px]" />
        <span>{event.date} - {event.time}</span>
      </div>
      
      {event.link && (
        <a href={event.link} target="_blank" rel="noopener noreferrer" class="w-full py-3 px-6 border border-blue-400 text-blue-300 text-xs font-bold rounded hover:bg-blue-400/10 transition-colors uppercase tracking-wider relative overflow-hidden group/btn text-center block">
          <span class="relative z-10">{event.actionLabel || (event.status === 'upcoming' ? 'PRÓXIMAMENTE' : 'MÁS INFORMACIÓN')}</span>
          <div class="absolute inset-0 bg-blue-400/10 translate-y-full group-hover/btn:translate-y-0 transition-transform duration-300"></div>
        </a>
      )}
      
      <div class="flex flex-wrap gap-2 pt-4 border-t border-gray-800">
        {event.tags.map(tag => (
          <span class="px-3 py-1 bg-blue-500/10 border border-blue-500/20 text-blue-300 text-[10px] font-bold uppercase rounded-full tracking-wider">{tag}</span>
        ))}
      </div>
    </div>
  </div>
</div>

<style>
  .card-gradient {
    background: linear-gradient(135deg, rgba(30, 41, 59, 1) 0%, rgba(30, 41, 59, 0.8) 100%);
  }
</style>
