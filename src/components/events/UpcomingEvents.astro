---
import type { Event } from "../../types/events";
import EventCard from "./EventCard.astro";

interface Props {
  events: Event[];
}

const { events } = Astro.props;
const upcomingEvents = events.filter((e) => e.status === "upcoming");
---

<section
  class="flex flex-col space-y-8 mt-16 relative z-10 w-full max-w-7xl mx-auto px-6"
>
  <div
    class="flex flex-col justify-between items-start mb-4 border-b border-gray-800 pb-4 w-full"
  >
    <h2 class="text-[32px] md:text-[40px] font-black text-white">
      Próximos Eventos
    </h2>
  </div>

  {
    upcomingEvents.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {upcomingEvents.map((event) => (
          <EventCard event={event} />
        ))}
      </div>
    ) : (
      <div class="w-full rounded-2xl border border-gray-800 bg-[#172033]/40 py-8 px-6 md:py-10 md:px-8 flex flex-col items-center justify-center text-center relative overflow-hidden group">
        <div class="w-13 h-13 rounded-full bg-blue-500/10 border border-blue-500/20 flex items-center justify-center mb-3 text-blue-300">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-6 h-6"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.8"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
            />
          </svg>
        </div>
        <h3 class="text-[18px] md:text-[24px] font-black text-white tracking-wider uppercase mb-1.5">
          PRÓXIMAMENTE MÁS EVENTOS
        </h3>
        <p class="text-[12px] sm:text-[14px] md:text-[16px] text-gray-400 font-light leading-relaxed">
          Estamos preparando nuevas experiencias. ¡Mantente atento a nuestras
          redes sociales!
        </p>
      </div>
    )
  }
</section>
