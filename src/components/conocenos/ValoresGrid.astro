---
import ValorCard from './ValorCard.astro';

const valoresFila1 = [
	{ title: "Excelencia Técnica", icon: "medal" },
	{ title: "Ética e Integridad", icon: "ethics" },
	{ title: "Inclusión y Diversidad", icon: "diversity" },
	{ title: "Colaboración", icon: "collaboration" },
];

const valoresFila2 = [
	{ title: "Innovación Responsable", icon: "innovation" },
	{ title: "Transparencia", icon: "transparency" },
	{ title: "Accesibilidad al Conocimiento", icon: "knowledge" },
];
---

<section class="mb-24 md:mb-32 relative z-10">
	<!-- Título de Sección -->
	<h2 class="text-3xl md:text-4xl font-extrabold text-center text-white mb-12 md:mb-16 tracking-tight">
		<span class="text-blue-300 text-glow-blue">
			Valores constitucionales
		</span>
	</h2>

	<!-- Grid de Valores: Fila 1 (4 columnas en Desktop) con separación amplia -->
	<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 md:gap-8 mb-6 md:mb-8">
		{valoresFila1.map((valor) => (
			<ValorCard title={valor.title} icon={valor.icon} />
		))}
	</div>

	<!-- Grid de Valores: Fila 2 (3 columnas centradas en Desktop) con separación amplia -->
	<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8 max-w-5xl mx-auto">
		{valoresFila2.map((valor) => (
			<ValorCard title={valor.title} icon={valor.icon} />
		))}
	</div>
</section>
